{
  "jit": {
    "type": "categorical",
    "choices": { "mode": "discrete", "values": [0] }
  },
  "random_page_cost": {
    "type": "float",
    "choices": { "mode": "range", "values": { "min": 1.0, "max": 4.0 } }
  },
  "default_statistics_target": {
    "type": "int",
    "choices": { "mode": "range", "values": { "min": 100, "max": 400 } }
  },
  "max_parallel_workers": {
    "type": "int",
    "choices": { "mode": "range", "values": { "min": 1, "max": 2 } }
  },
  "max_parallel_workers_per_gather": {
    "type": "int",
    "choices": { "mode": "range", "values": { "min": 1, "max": 1 } }
  },
  "shared_buffers": {
    "type": "categorical",
    "choices": { "mode": "discrete", "values": ["256MB", "384MB", "512MB"] }
  },
  "effective_cache_size": {
    "type": "categorical",
    "choices": { "mode": "discrete", "values": ["1024MB", "1280MB", "1536MB"] }
  },
  "work_mem": {
    "type": "categorical",
    "choices": { "mode": "discrete", "values": ["16MB", "32MB", "64MB"] }
  },
  "enable_hashagg": {
    "type": "categorical",
    "choices": { "mode": "discrete", "values": ["on", "off"] }
  },
  "enable_bitmapscan": {
    "type": "categorical",
    "choices": { "mode": "discrete", "values": ["on", "off"] }
  },
  "enable_nestloop": {
    "type": "categorical",
    "choices": { "mode": "discrete", "values": ["on", "off"] }
  },
  "enable_parallel_hash": {
    "type": "categorical",
    "choices": { "mode": "discrete", "values": ["on", "off"] }
  },
  "enable_sort": {
    "type": "categorical",
    "choices": { "mode": "discrete", "values": ["on", "off"] }
  }
}
