# Ambiente virtual
.venv/

# Documentação gerada
site/
documentacao/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# IDEs
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# ── output/ — diretório legado (substituído por data/ e logs/)  ──────────
output/

# ── Gerado por pip install -e . ───────────────────────────────────────────
*.egg-info/

# ── data/ — estrutura CCDS (Cookiecutter Data Science) ───────────────────
# data/raw/       → benchmark results JSON originais (2.2 GB, não versionados);
#                   EXCEÇÃO: data/raw/rodada{1,2}/ são as versões "enxutas"
#                   (~2,8 MB cada, só os campos que extract_features.py lê),
#                   versionadas de propósito pra reproduzir o treino sem
#                   precisar rodar nenhum benchmark de novo.
# data/models/    → modelos treinados XGBoost (gerados por make train)
# data/processed/ → features.csv VERSIONADO (984 KB, reproduz o ML)

data/raw/*
!data/raw/rodada1/
!data/raw/rodada1/**
!data/raw/rodada2/
!data/raw/rodada2/**
data/models/
data/.runner.lock

# logs gerados em runtime
logs/*.log

# Configurações locais do Claude
.claude/settings.local.json
